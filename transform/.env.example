# Copy to transform/.env (gitignored). dbt reads env vars, not this file.
# Variable NAMES only — no key material. JSON de SA: fuera de git.

# --- GCP / BigQuery (dbt) ---
DBT_BIGQUERY_PROJECT=vaca-muerta-pulse
# Alias accepted by profiles.yml.example / ADC:
# BIGQUERY_PROJECT=vaca-muerta-pulse
BIGQUERY_LOCATION=US

# Datasets Hito 2 (dev). Prod twins (stg_cap4 / int_cap4 / marts_cap4) = follow-up.
# Raw source Hito 2 primary = raw_cap4_dev. Prod twin = raw_cap4 (dataset does not exist yet).
DBT_DATASET_RAW=raw_cap4_dev
DBT_DATASET_STG=stg_cap4_dev
DBT_DATASET_INT=int_cap4_dev
DBT_DATASET_MARTS=marts_cap4_dev

# Optional fallback only (custom generate_schema_name wins).
# DBT_BQ_DATASET=stg_cap4_dev

# dbt target in profiles.yml.example: dev | prod
# DBT_TARGET=dev

# Local: path to the dbt SA JSON (gitignored). NOT the Meltano file.
# SA name (docs only): vm-pulse-dbt
GOOGLE_APPLICATION_CREDENTIALS=./.secrets/vm-pulse-dbt.json

# --- Credentials from a secret store (GitHub Actions / Cursor Cloud) ---
# Separate from Meltano's GCP_SA_KEY.
# PREFERRED: the ENTIRE contents of the downloaded .json key file:
# GCP_SA_KEY_DBT=<full service-account key JSON of vm-pulse-dbt>
# Cursor Cloud / GH: paste via the Add secrets menu (same flow as GCP_SA_KEY).
# Optional PEM fallback (same pattern as extraction/scripts/materialize-sa-key.sh):
# GCP_SA_CLIENT_EMAIL_DBT=vm-pulse-dbt@<project-id>.iam.gserviceaccount.com
# GCP_SA_CLIENT_EMAIL=vm-pulse-dbt@<project-id>.iam.gserviceaccount.com
