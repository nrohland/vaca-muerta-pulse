# Copy to transform/.env if you like; dbt reads env vars, not this file.
# Names only — no keys. JSON de SA: fuera de git.

BIGQUERY_PROJECT=vaca-muerta-pulse
BIGQUERY_LOCATION=US
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/sa.json

# Optional: override the default dbt dataset (generate_schema_name still
# writes stg_cap4[_dev] / int_cap4[_dev] / marts[_dev]).
# DBT_BQ_DATASET=analytics_dev

# dbt target in profiles.yml.example: dev | prod
# DBT_TARGET=dev
