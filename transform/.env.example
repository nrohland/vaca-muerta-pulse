# Copy to transform/.env (gitignored). Variable NAMES only — no key material.
# GCP project id: copy BIGQUERY_PROJECT from extraction/.env.example (same project as Hito 1).

# --- GCP / BigQuery ---
BIGQUERY_PROJECT=
BIGQUERY_LOCATION=US
# Local: point to the dbt SA key JSON (kept out of git). .secrets/ is gitignored.
GOOGLE_APPLICATION_CREDENTIALS=./.secrets/vm-pulse-dbt.json

# --- Credentials from a secret store (GitHub Actions / Cursor Cloud) ---
# SEPARATE from Meltano GCP_SA_KEY. Do not reuse the Meltano key for dbt.
# PREFERRED: the ENTIRE contents of the downloaded vm-pulse-dbt.json key file:
# GCP_SA_KEY_DBT=<full service-account key JSON>
# GCP_SA_KEY_DBT_BASE64=<base64 of the JSON>
# FALLBACK: if GCP_SA_KEY_DBT holds only the PEM private key, also set:
# GCP_SA_DBT_CLIENT_EMAIL=vm-pulse-dbt@<project-id>.iam.gserviceaccount.com
