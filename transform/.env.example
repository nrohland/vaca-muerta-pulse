# Copy to transform/.env if you like; dbt reads env vars, not this file.
# Names only — no keys. JSON de SA: fuera de git.

BIGQUERY_PROJECT=vaca-muerta-pulse
BIGQUERY_LOCATION=US
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/sa.json

# Optional: unused for project models (custom schemas win). Fallback only.
# DBT_BQ_DATASET=stg_cap4_dev

# Raw source. Hito 2 primary = raw_cap4_dev. Prod twin = raw_cap4.
# DBT_RAW_DATASET=raw_cap4_dev

# dbt target in profiles.yml.example: dev | prod
# DBT_TARGET=dev

# SA name (docs only): vm-pulse-dbt
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/vm-pulse-dbt.json
