# Copy to extraction/.env (gitignored). Variable NAMES only — no key material.

# --- GCP / BigQuery ---
BIGQUERY_PROJECT=vaca-muerta-pulse
BIGQUERY_LOCATION=US
BIGQUERY_DATASET=raw_cap4
# Local: point to the SA key JSON file (kept out of git). The .secrets/ dir is gitignored.
GOOGLE_APPLICATION_CREDENTIALS=./.secrets/vm-pulse-meltano.json

# Optional override of the Meltano plugin setting credentials_path:
# TARGET_BIGQUERY_CREDENTIALS_PATH=./.secrets/vm-pulse-meltano.json

# --- Credentials from a secret store (GitHub Actions / Cursor Cloud) ---
# Instead of committing a file, provide the SA key as a secret env var and let
# scripts/materialize-sa-key.sh write it to .secrets/ at runtime.
# PREFERRED: the ENTIRE contents of the downloaded .json key file:
# GCP_SA_KEY=<full service-account key JSON>
# GCP_SA_KEY_BASE64=<base64 of the JSON>
# FALLBACK: if GCP_SA_KEY holds only the PEM private key, also set the SA email
# so the JSON can be reconstructed:
# GCP_SA_CLIENT_EMAIL=vm-pulse-meltano@<project-id>.iam.gserviceaccount.com
#
# Hito 2 dbt uses a *different* SA and secret. Do not point Meltano at it.
# See transform/.env.example (GCP_SA_KEY_DBT, DBT_DATASET_*).

# --- Meltano ---
# MELTANO_ENVIRONMENT=dev
# Smoke (500–5000). Año completo: dejar MAX_RECORDS vacío.
# TAP_CKAN_DATASTORE_MAX_RECORDS=500
# TAP_CKAN_DATASTORE_PAGE_SIZE=500
# Full-year Meltano (CI + este run): ALLOW_FULL_YEAR_LOAD=true
# ALLOW_FULL_YEAR_LOAD=true

# --- Capítulo IV (public UUIDs; already defaulted in extraction/meltano.yml) ---
# TAP_CKAN_DATASTORE_PRODUCCION_RESOURCE_ID=d774b5d7-0756-48fe-88f2-8729b57b22da
# TAP_CKAN_DATASTORE_POZOS_RESOURCE_ID=cb5c0f04-7835-45cd-b982-3e25ca7d7751
# TAP_CKAN_DATASTORE_FRACTURAS_RESOURCE_ID=2280ad92-6ed3-403e-a095-50139863ab0d
