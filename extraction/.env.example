# Copy to extraction/.env (gitignored). Variable NAMES only — no key material.

# --- GCP / BigQuery ---
BIGQUERY_PROJECT=vaca-muerta-pulse
BIGQUERY_LOCATION=US
BIGQUERY_DATASET=raw_cap4
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/meltano-raw-writer.json

# Optional override of the Meltano plugin setting credentials_path:
# TARGET_BIGQUERY_CREDENTIALS_PATH=/absolute/path/to/meltano-raw-writer.json

# --- Meltano ---
# MELTANO_ENVIRONMENT=dev
# TAP_CKAN_DATASTORE_MAX_RECORDS=50

